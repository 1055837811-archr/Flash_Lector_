@using Flash_Lector.Models
@model Obra
@{
    var favoritos = ViewData["IdsFavoritos"] as HashSet<int>;
    var esFavorito = favoritos?.Contains(Model.Id) == true;
    var sesionIniciada = User.Identity?.IsAuthenticated == true;
    var temas = new[] { "cover-blue", "cover-orange", "cover-night", "cover-gold" };
}
<article class="book-card">
    <div class="cover @temas[Model.Id % temas.Length]">
        <a class="cover-link" asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@Model.Id" aria-label="@Model.Titulo"></a>
        <span class="fmt">@Model.Formato</span>
        @if (sesionIniciada)
        {
            <form class="fav" asp-controller="Favoritos" asp-action="Alternar" method="post">
                <input type="hidden" name="obraId" value="@Model.Id">
                <input type="hidden" name="urlRetorno" value="@(Context.Request.Path + Context.Request.QueryString)">
                <button class="@(esFavorito ? "on" : "")" aria-label="@(esFavorito ? "Quitar de favoritos" : "Añadir a favoritos")"><svg class="icon"><use href="#i-heart" /></svg></button>
            </form>
        }
        else
        {
            <a class="fav" asp-controller="Cuenta" asp-action="InicioSesion" aria-label="Ingresa para guardar en favoritos"><span><svg class="icon"><use href="#i-heart" /></svg></span></a>
        }
        <svg class="bolt-art" aria-hidden="true"><use href="#i-bolt" /></svg>
        <b class="cover-title">@Model.Titulo</b>
    </div>
    <div class="book-meta"><small>@Model.Categoria?.Nombre · @Model.Formato</small><p>@Model.NombreAutor</p></div>
</article>