@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var categoria = Context.Request.Query["categoria"].ToString();
    var sesionIniciada = User.Identity?.IsAuthenticated == true;
    var inicial = sesionIniciada && !string.IsNullOrEmpty(User.Identity!.Name) ? char.ToUpperInvariant(User.Identity.Name![0]).ToString() : "";
    string Activo(bool encendido) => encendido ? "active" : "";
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@ViewData["Title"] · Flash Lector</title>
    <script>try { var t = localStorage.getItem('fl-theme'); if (t) document.documentElement.dataset.theme = t } catch (e) { }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,600;0,700;1,700&family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@600;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></symbol>
        <symbol id="i-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></symbol>
        <symbol id="i-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></symbol>
        <symbol id="i-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></symbol>
        <symbol id="i-book" viewBox="0 0 24 24"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" /><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" /></symbol>
    </svg>

    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Flash Lector, inicio">
            <span class="brand-mark"><svg class="icon"><use href="#i-book" /></svg><svg class="icon mini"><use href="#i-bolt" /></svg></span>
            <b>FLASH LECTOR</b>
        </a>
        <form class="search" asp-controller="Catalogo" asp-action="Index" method="get" role="search">
            <svg class="icon"><use href="#i-search" /></svg>
            <input name="q" placeholder="Título, autor, manga, cómic" aria-label="Buscar en el catálogo">
            <button class="sr-only">Buscar</button>
        </form>
        <nav class="top-actions">
            <button type="button" class="icon-btn" data-theme-toggle aria-label="Cambiar entre modo claro y oscuro"><svg class="icon"><use href="#i-moon" /></svg></button>
            <a class="icon-btn" asp-controller="Favoritos" asp-action="Index" aria-label="Favoritos"><svg class="icon"><use href="#i-heart" /></svg></a>
            @if (sesionIniciada)
            {
                <span class="avatar" title="@User.Identity!.Name">@inicial</span>
                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post"><button class="link">Salir</button></form>
            }
            else
            {
                <a class="link" asp-controller="Cuenta" asp-action="InicioSesion">Ingresar</a>
                <a class="pill" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
            }
        </nav>
    </header>

    <div class="app-shell">
        <aside>
            <nav class="side-nav" aria-label="Principal">
                <a class="@Activo(controlador == "Home")" asp-controller="Home" asp-action="Index"><svg class="icon"><use href="#i-bolt" /></svg>Inicio</a>
                <a class="@Activo(controlador == "Favoritos")" asp-controller="Favoritos" asp-action="Index"><svg class="icon"><use href="#i-heart" /></svg>Favoritos</a>
                <a class="no-icon @Activo(controlador == "Catalogo" && categoria == "1")" asp-controller="Catalogo" asp-action="Index" asp-route-categoria="1">Académico</a>
                <a class="no-icon @Activo(controlador == "Catalogo" && categoria == "2")" asp-controller="Catalogo" asp-action="Index" asp-route-categoria="2">Literatura</a>
                <a class="no-icon @Activo(controlador == "Catalogo" && categoria == "3")" asp-controller="Catalogo" asp-action="Index" asp-route-categoria="3">Cómics</a>
                <a class="no-icon @Activo(controlador == "Catalogo" && categoria == "4")" asp-controller="Catalogo" asp-action="Index" asp-route-categoria="4">Mangas</a>
                @if (sesionIniciada)
                {
                    <hr>
                    <a class="no-icon @Activo(controlador == "Obras")" asp-controller="Obras" asp-action="Index">Mis obras</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="no-icon @Activo(controlador == "Administracion")" asp-controller="Administracion" asp-action="Index">Administración</a>
                    }
                }
            </nav>
            <p class="tagline">Lee · Aprende · Descubre</p>
        </aside>
        <main>@RenderBody()</main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>