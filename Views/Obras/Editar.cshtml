@using Flash_Lector.ViewModels
@model ObraFormularioViewModel
@{
    ViewData["Title"] = "Editar obra";
}

<section class="form-panel">
    <span class="eyebrow">Actualizar publicación</span>
    <h1>Editar obra</h1>

    <form asp-action="Editar" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden">
        <partial name="_Formulario" model="Model" />
    </form>
</section>